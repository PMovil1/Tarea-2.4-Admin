<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:padding="28dp">
<ImageView android:layout_width="88dp" android:layout_height="88dp" android:padding="22dp" android:background="@drawable/logo_background" android:src="@drawable/ic_notebook" android:importantForAccessibility="no" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/app_name" android:textSize="28sp" android:textColor="@color/text_primary" android:gravity="center" android:textStyle="bold"/>
<com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:indeterminate="true" android:visibility="gone" android:contentDescription="@string/loading" app:indicatorSize="28dp" app:trackThickness="3dp" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/verifying" android:textSize="20sp" android:textColor="@color/text_primary" android:id="@+id/status" android:gravity="center" android:accessibilityLiveRegion="polite"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="" android:textSize="16sp" android:textColor="@color/text_primary" android:id="@+id/identity" android:gravity="center"/>
<com.google.android.material.button.MaterialButton android:id="@+id/retryButton" style="@style/Widget.Bitacora.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="54dp" android:layout_marginTop="24dp" android:text="@string/retry" />
<com.google.android.material.button.MaterialButton android:id="@+id/logoutButton" style="@style/Widget.Bitacora.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="54dp" android:layout_marginTop="24dp" android:text="@string/logout" />
</LinearLayout>
</ScrollView>