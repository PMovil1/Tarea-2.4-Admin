<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:padding="28dp">
<Space android:layout_width="1dp" android:layout_height="32dp" />
<ImageView android:layout_width="88dp" android:layout_height="88dp" android:padding="22dp" android:background="@drawable/logo_background" android:src="@drawable/ic_notebook" android:importantForAccessibility="no" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/app_name" android:textSize="30sp" android:textColor="@color/green_dark" android:gravity="center" android:textStyle="bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:text="@string/welcome_back" android:textSize="24sp" android:textColor="@color/text_primary" android:textStyle="bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/login_subtitle" android:textSize="15sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="4dp"/>
<com.google.android.material.textfield.TextInputLayout android:id="@+id/emailLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:hint="@string/email" app:startIconDrawable="@drawable/ic_email" >
<com.google.android.material.textfield.TextInputEditText android:id="@+id/emailInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp" android:inputType="textEmailAddress" android:maxLines="1" android:imeOptions="actionNext" android:autofillHints="emailAddress" android:saveEnabled="true" android:textColor="@color/text_primary" android:textSize="16sp" />
</com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:id="@+id/passwordLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:hint="@string/password" app:startIconDrawable="@drawable/ic_lock" app:endIconMode="password_toggle" app:endIconContentDescription="@string/show_password">
<com.google.android.material.textfield.TextInputEditText android:id="@+id/passwordInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp" android:inputType="textPassword" android:maxLines="1" android:imeOptions="actionDone" android:autofillHints="password" android:saveEnabled="false" android:textColor="@color/text_primary" android:textSize="16sp" />
</com.google.android.material.textfield.TextInputLayout>
<TextView android:id="@+id/message" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:accessibilityLiveRegion="polite" android:textColor="@color/error" android:textSize="14sp" android:visibility="gone" />
<com.google.android.material.button.MaterialButton android:id="@+id/loginButton" style="@style/Widget.Bitacora.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="54dp" android:layout_marginTop="24dp" android:text="@string/login" />
<com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:indeterminate="true" android:visibility="gone" android:contentDescription="@string/loading" app:indicatorSize="28dp" app:trackThickness="3dp" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:text="@string/footer" android:textSize="12sp" android:textColor="@color/text_secondary" android:gravity="center" android:paddingBottom="16dp"/>
</LinearLayout>
</ScrollView>