    {
      "name": "Autenticacion - Edgardo",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.info.requestName === \"Registro Usuario (intento de Admin ignorado)\") {",
              "  pm.collectionVariables.set(\"authEmail\", \"auth-\" + pm.variables.replaceIn(\"{{$guid}}\") + \"@example.com\");",
              "  pm.collectionVariables.set(\"authPassword\", \"Test-\" + pm.variables.replaceIn(\"{{$guid}}\"));",
              "}"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Registro Usuario (intento de Admin ignorado)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
