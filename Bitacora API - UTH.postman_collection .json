        {
          "name": "Login correcto",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"{{authEmail}}\", \"password\": \"{{authPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test(\"Rol Usuario, nunca Admin\", () => pm.expect(data.role).to.eql(\"Usuario\"));",
                  "pm.test(\"Token y vencimiento\", () => { pm.expect(data.token.split(\".\")).to.have.lengthOf(3); pm.expect(Date.parse(data.expiration)).to.be.above(Date.now()); });",
                  "pm.test(\"Sin hash\", () => pm.expect(data).not.to.have.property(\"passwordHash\"));"
                ]
              }
            }
          ]
        },
