                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado esperado: 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  pm.environment.set(\"tokenUsuario\", pm.response.json().token);",
                  "}"
                ]
              }
            }
          ]
